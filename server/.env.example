# Environment
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ys_engineers

# Server
# Default 5500 to avoid macOS AirPlay Receiver on :5000 and common dev-server
# defaults on :3000/:5173. If you run VS Code's Live Server extension, pick
# a different port here (it also defaults to 5500).
PORT=5500
CLIENT_ORIGIN=http://localhost:5170
PUBLIC_URL=http://localhost:5170

# Auth
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=ys_auth

# Admin user (created by `npm run seed`)
ADMIN_EMAIL=admin@ys-engineers.co.il
ADMIN_PASSWORD=ChangeMe123!

# SMTP for contact-form and password-reset email (nodemailer)
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="י.ש. מהנדסים <no-reply@ys-engineers.co.il>"
MAIL_TO=info@ys-engineers.co.il

# Uploads
UPLOAD_MAX_BYTES=5242880
UPLOAD_DIR=uploads
