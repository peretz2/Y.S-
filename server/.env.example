# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/ys_engineers

# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin user (created by `npm run seed`)
ADMIN_EMAIL=admin@ys-engineers.co.il
ADMIN_PASSWORD=ChangeMe123!

# SMTP for contact-form email (nodemailer)
# For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="י.ש. מהנדסים <no-reply@ys-engineers.co.il>"
MAIL_TO=info@ys-engineers.co.il
